<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="~/images/logo.png" />
    <!--CSS-->
    <link rel="stylesheet" href="~/css/settings/_variables.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/base/_reset.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/layout/_layout.css" asp-append-version="true">
    <!--components-->
    <link rel="stylesheet" href="~/css/components/_button.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components/_avatar.css" asp-append-version="true" />
    <!--Import View file/CSS code to header -->
    @RenderSection("head", required: false)
</head>
<body>
    <header class="app-nav">
        <div class="app-nav__inner">
            <!--left-->
            <div class="app-nav__group">
                <img class="app-nav__logo" src="~/images/logo.png" alt="Logo">
                <span class="app-nav__brand">67 Food</span>                
                <a class="app-nav__link" href="#">HOME</a>
                <a class="app-nav__link" href="#">ABOUT</a>
            </div>
            <!--right-->
            <div class="app-nav__group">
                <a class="app-nav__link" href="#">CART</a>
                <a class="app-nav__link" href="#">MY ORDER</a>
                <img src="/images/user/user.png" alt="User Avatar" class="avatar" />
            </div>

        </div>
    </header>

    <main class="page-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="app-footer__inner">
            <p>Copyrighted &copy; @DateTime.Today.Year</p>
            <a class="app-footer__link" href="#">Privacy Policy</a>
            <a class="app-footer__link" href="#">Terms of Service</a>
        </div>
    </footer>
    <!--Js Lib-->
    <script src="~/jsLib/jquery.min.js"></script>
    <!--java script-->
    <script src="~/js/app.js" asp-append-version="true"></script>
    <!--Import View file code to foot example:js file -->
    @RenderSection("foot", required: false)
</body>
</html>