<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="~/images/sample.jpg" />
    <title>@ViewBag.Title</title>
    <!--CSS-->
    <link rel="stylesheet" href="~/css/settings/_variables.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/base/_reset.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/layout/_layout.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/components/_button.css" asp-append-version="true">

    <!--Import View file code to header -->
    @RenderSection("head", required: false)
</head>
<body>
    <header class="app-nav">
        <div class="container app-nav__inner">
            <a class ="app-nav__brand">Website name</a>
            <a class="app-nav__link" asp-controller="Home" asp-action="Index">HOME</a>
        </div>
    </header>

    <main class="page-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container app-footer__inner">
            <p>Copyrighted &copy; @DateTime.Today.Year</p>
            <a class="app-footer__link" href="#">Privacy Policy</a>
            <a class="app-footer__link" href="#">Terms of Service</a>
        </div>
    </footer>
    <!--Js Lib-->
    <script src="~/jsLib/jquery.min.js"></script>
    <!--java script-->
    <script src="~/js/app.js" asp-append-version="true"></script>
    <!--Import View file code to foot example:js file -->
    @RenderSection("foot", required: false)
</body>
</html>